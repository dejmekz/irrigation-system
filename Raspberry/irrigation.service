[Unit]
Description=Irrigation Control Service
After=network.target mosquitto.service

[Service]
Type=simple
User=openhabian
WorkingDirectory=/home/openhabian/irrigation
EnvironmentFile=/home/openhabian/irrigation/.env
ExecStart=/home/openhabian/irrigation/venv/bin/python run.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
